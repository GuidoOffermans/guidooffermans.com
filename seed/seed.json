  "collections": [
    {
      "slug": "work",
      "label": "Work",
      "labelSingular": "Work",
      "supports": ["drafts", "revisions"],
      "urlPattern": "/work/{slug}",
      "routable": true,
      "titleField": "title",
      "dateField": "end_date",
      "admin": { "listColumns": ["company_name", "start_date", "end_date"] },
      "fields": [
        { "slug": "title", "label": "Title", "type": "string", "required": true },
        { "slug": "company_name", "label": "Company name", "type": "string", "required": true },
        { "slug": "role", "label": "Role", "type": "string", "required": true },
        { "slug": "description", "label": "Description", "type": "text", "required": true },
        { "slug": "start_date", "label": "Start date", "type": "datetime", "required": true, "indexed": true },
        { "slug": "end_date", "label": "End date", "type": "datetime", "required": true, "indexed": true },
        { "slug": "body", "label": "Body", "type": "portableText" }
      ]
    },
    {
      "slug": "projects",
      "label": "Projects",
      "labelSingular": "Project",
      "supports": ["drafts", "revisions"],
      "urlPattern": "/projects/{slug}",
      "routable": true,
      "titleField": "title",
      "dateField": "worked_on",
      "admin": { "listColumns": ["website", "list_number", "worked_on"] },
      "fields": [
        { "slug": "title", "label": "Title", "type": "string", "required": true },
        { "slug": "website", "label": "Website", "type": "url", "required": true },
        { "slug": "description", "label": "Description", "type": "text", "required": true },
        { "slug": "list_number", "label": "List number", "type": "integer", "required": true, "indexed": true },
        { "slug": "worked_on", "label": "Worked on", "type": "datetime", "required": true },
        { "slug": "body", "label": "Body", "type": "portableText" }
      ]
    },
    {
      "slug": "posts",
      "label": "Blog posts",
      "labelSingular": "Blog post",
      "supports": ["drafts", "revisions", "search", "seo"],
      "urlPattern": "/blog/{slug}",
      "routable": true,
      "titleField": "title",
      "fields": [
        { "slug": "title", "label": "Title", "type": "string", "required": true, "searchable": true },
        { "slug": "description", "label": "Description", "type": "text", "required": true },
        { "slug": "hero_image", "label": "Hero image", "type": "image" },
        { "slug": "content", "label": "Content", "type": "portableText", "searchable": true }
      ]
    }
  ],
