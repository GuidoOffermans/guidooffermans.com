{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "guidooffermans-com",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "guidooffermans-com",
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "guidooffermans-com-media",
    },
  ],
  // Runs EmDash scheduled publishing
  "triggers": { "crons": ["* * * * *"] },
}
