---
import type { ContentEntry, InferCollectionData } from "emdash";
interface Props {
    work: ContentEntry<InferCollectionData<"work">>;
}

import FormattedDate from "./FormattedDate.astro";
const { work } = Astro.props;
---

<li
    class="font-mono recursive text-xs md:text-xl tracking-[0.09em] md:tracking-[0.08em] leading-[18px] md:leading-[30px] uppercase"
>
    <strong class="font-normal text-go-orange">
        <a href={`/work/${work.id}/`}>{work.data.company_name}</a>
    </strong>–
    <span>{work.data.role} {work.data.description}.</span>
    <span class="whitespace-normal inline-block tracking-0">
        <FormattedDate type="work" date={new Date(work.data.start_date)} />-
        <FormattedDate type="work" date={new Date(work.data.end_date)} />
    </span>
</li>
